{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/loreforge-prompt-hook.sh",
            "statusMessage": "Checking LoreForge routing"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/loreforge-prompt-hook.sh",
            "statusMessage": "Loading LoreForge runtime hook"
          }
        ]
      }
    ]
  }
}
